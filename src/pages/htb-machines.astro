---
import ClassifiedHeader from "@components/ClassifiedHeader.astro";
import HTBMachinesPanel from "@components/HTBMachinesPanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { machines } from "../data/htb-machines";
---

<MainGridLayout title="HTB Machines Archive">
    <ClassifiedHeader
        code="TARGET-RANGE"
        title="HTB · Active Directory"
        subtitle="Live-fire target range — HackTheBox AD machines, progression, flags and full write-ups."
        status="TARGETS ACQUIRED"
        icon="🏴"
        stamp="OPS RANGE"
    />

    <HTBMachinesPanel {machines} client:only="svelte" />
</MainGridLayout>
