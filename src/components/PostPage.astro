---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import CaseFileCard from "./CaseFileCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---
<div class="evidence-board mb-4">
    <div class="evidence-board__banner col-span-full">
        <span class="tape">CASE FILES</span>
        <span class="text-sm opacity-90">// {page.data.length} active investigations — click a file to open</span>
    </div>
    {page.data.map((entry: CollectionEntry<"posts">, i: number) => (
        <CaseFileCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                index={i}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></CaseFileCard>
    ))}
</div>
