---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import BloodSlide from "./BloodSlide.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---
<div class="slide-box">
    <span class="slide-box__corner tl"></span>
    <span class="slide-box__corner tr"></span>
    <span class="slide-box__corner bl"></span>
    <span class="slide-box__corner br"></span>
    <span class="slide-box__hinge left"></span>
    <span class="slide-box__hinge right"></span>
    <span class="slide-box__latch"></span>

    <div class="slide-box__lid">
        <div class="slide-box__plate"><span class="dot"></span>SPECIMEN ARCHIVE · {page.data.length} SLIDES</div>
    </div>

    <div class="slide-box__tray">
        {page.data.map((entry: CollectionEntry<"posts">, i: number) => (
            <BloodSlide
                    entry={entry}
                    title={entry.data.title}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    published={entry.data.published}
                    url={getPostUrlBySlug(entry.slug)}
                    description={entry.data.description}
                    index={i}
                    class:list="onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
            ></BloodSlide>
        ))}
    </div>
</div>
