<!-- Global mouse trail particle effect -->
<canvas id="mouse-trail-canvas" class="fixed inset-0 pointer-events-none z-[9999]"></canvas>

<script>
function initMouseTrail() {
    const canvas = document.getElementById('mouse-trail-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let particles: { x: number; y: number; vx: number; vy: number; life: number; maxLife: number; size: number; }[] = [];
    let mouseX = 0;
    let mouseY = 0;
    let animationId: number;

    function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;

        // Spawn particles on mouse move
        for (let i = 0; i < 2; i++) {
            particles.push({
                x: mouseX + (Math.random() - 0.5) * 4,
                y: mouseY + (Math.random() - 0.5) * 4,
                vx: (Math.random() - 0.5) * 1.5,
                vy: (Math.random() - 0.5) * 1.5,
                life: 0,
                maxLife: 30 + Math.random() * 20,
                size: 1.5 + Math.random() * 2,
            });
        }

        // Keep particle count manageable
        if (particles.length > 80) {
            particles = particles.slice(-80);
        }
    });

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        particles = particles.filter(p => {
            p.life++;
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.02; // slight gravity
            p.vx *= 0.99;

            const progress = p.life / p.maxLife;
            const alpha = 1 - progress;
            const size = p.size * (1 - progress * 0.5);

            // Green/teal glow matching theme
            ctx.beginPath();
            ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(138, 180, 248, ${alpha * 0.6})`;
            ctx.fill();

            // Outer glow
            ctx.beginPath();
            ctx.arc(p.x, p.y, size * 2, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(138, 180, 248, ${alpha * 0.15})`;
            ctx.fill();

            return p.life < p.maxLife;
        });

        animationId = requestAnimationFrame(animate);
    }

    animate();

    // Cleanup on page transition
    const cleanup = () => {
        cancelAnimationFrame(animationId);
        particles = [];
    };

    // Reinitialize on Swup page transitions
    if (window.swup) {
        window.swup.hooks.on('content:replace', () => {
            resize();
        });
    }
}

// Init on load
initMouseTrail();

// Reinit on Swup page views
const setupTrail = () => {
    if (window.swup) {
        window.swup.hooks.on('page:view', initMouseTrail);
    }
};
if (window.swup) {
    setupTrail();
} else {
    document.addEventListener('swup:enable', setupTrail);
}
</script>
