---
interface Props {
  title: string;
  count: number;
  color: string;
  image: ImageMetadata;
  href: string;
  class?: string;
  style?: string;
}

const { title, count, color, image, href, class: className, style } = Astro.props;
const label = count === 1 ? 'POST' : 'POSTS';
---

<a
  href={href}
  class:list={["category-card group relative block overflow-hidden rounded-lg border-2 transition-all duration-300 cursor-pointer", className]}
  style={`border-color: ${color}; ${style || ''}`}
>
  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src={image.src}
      alt={title}
      class="w-full h-full object-cover opacity-60 transition-all duration-300 group-hover:scale-110 group-hover:opacity-80"
      loading="lazy"
    />
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-black/60"></div>
    <!-- Color tint -->
    <div class="absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100" style={`background: ${color}10;`}></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 flex items-center justify-between px-6 py-8 md:py-10">
    <h3 class="text-xl md:text-2xl font-bold text-white tracking-wide" style="font-family: 'JetBrains Mono Variable', 'Courier New', monospace;">
      {title}
    </h3>
    <div class="text-right flex-shrink-0 ml-4">
      <span class="text-3xl md:text-4xl font-bold text-white block leading-none">{count}</span>
      <span class="text-xs md:text-sm font-semibold text-white/80 tracking-widest">{label}</span>
    </div>
  </div>

  <!-- Hover glow effect on border -->
  <div
    class="absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style={`box-shadow: inset 0 0 30px ${color}20, 0 0 15px ${color}30;`}
  ></div>
</a>

<style>
  .category-card {
    animation: none;
  }
  .category-card:hover {
    animation: jiggle 0.4s ease-in-out;
  }

  @keyframes jiggle {
    0% { transform: rotate(0deg) scale(1); }
    15% { transform: rotate(-1.5deg) scale(1.01); }
    30% { transform: rotate(1.5deg) scale(1.01); }
    45% { transform: rotate(-1deg) scale(1.005); }
    60% { transform: rotate(1deg) scale(1.005); }
    75% { transform: rotate(-0.5deg) scale(1); }
    100% { transform: rotate(0deg) scale(1); }
  }
</style>
