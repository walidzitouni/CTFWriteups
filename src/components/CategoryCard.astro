---
interface Props {
    name: string;
    count: number;
    url: string;
    image: string;
    class?: string;
    style?: string;
}

const { name, count, url, image } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;
---
<a href={url} class:list={["group relative block overflow-hidden rounded-xl aspect-[16/9] active:scale-[0.98] transition-all duration-300", className]} style={style}>
    <!-- Background image -->
    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
         style={`background-image: url('${image}');`}>
    </div>
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20 group-hover:from-black/70 transition-all duration-300"></div>
    <!-- Content -->
    <div class="absolute bottom-0 left-0 right-0 p-5">
        <h3 class="text-white font-bold text-xl mb-1 group-hover:text-[var(--primary)] transition">{name}</h3>
        <span class="text-white/50 text-sm">{count} {count === 1 ? 'post' : 'posts'}</span>
    </div>
</a>
