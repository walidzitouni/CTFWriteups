---
// Custom animated "Red Team" banner: matrix-rain canvas + scanlines + glitch terminal hero.
// Rendered in place of the image/video banner when siteConfig.banner.matrix === true.
import { siteConfig } from "../config";

const title = siteConfig.title;
const subtitle = siteConfig.subtitle;
---

<div
	id="banner"
	class="cyber-banner overflow-hidden relative h-full transition duration-700 opacity-0 scale-105"
>
	<!-- Matrix rain -->
	<canvas id="cyber-matrix" class="absolute inset-0 w-full h-full"></canvas>

	<!-- Animated grid + glow overlays -->
	<div class="cyber-grid absolute inset-0 pointer-events-none"></div>
	<div class="cyber-scanlines absolute inset-0 pointer-events-none"></div>
	<div class="cyber-vignette absolute inset-0 pointer-events-none"></div>

	<!-- Glitch terminal hero -->
	<div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center pointer-events-none select-none">
		<div class="cyber-tag mb-4">
			<span class="cyber-blink">▮</span> SPECIMEN LOGGED — SESSION ESTABLISHED
		</div>

		<h1
			class="cyber-glitch font-bold tracking-tight text-white text-4xl sm:text-6xl md:text-7xl"
			data-text={title}
		>
			{title}
		</h1>

		<div class="cyber-terminal mt-5 text-left">
			<span class="cyber-prompt">root@daryx</span><span class="text-white/40">:</span><span class="cyber-path">~/ops</span><span class="text-white/40">$</span>
			<span id="cyber-type" class="cyber-typed"></span><span class="cyber-cursor">█</span>
		</div>

		<p class="mt-4 text-sm md:text-base text-white/70 max-w-xl tracking-wide">{subtitle}</p>
	</div>

	<!-- Bottom fade so content blends into the page -->
	<div class="cyber-fade absolute bottom-0 left-0 w-full pointer-events-none"></div>
</div>

<style>
	.cyber-banner {
		background:
			radial-gradient(ellipse at 50% 0%, oklch(0.30 0.12 var(--hue) / 0.55), transparent 60%),
			linear-gradient(180deg, oklch(0.12 0.02 var(--hue)), oklch(0.08 0.015 var(--hue)));
	}

	/* Moving perspective grid */
	.cyber-grid {
		background-image:
			linear-gradient(oklch(0.70 0.16 var(--hue) / 0.10) 1px, transparent 1px),
			linear-gradient(90deg, oklch(0.70 0.16 var(--hue) / 0.10) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: linear-gradient(180deg, transparent, black 35%, black 70%, transparent);
		animation: cyber-grid-pan 8s linear infinite;
	}
	@keyframes cyber-grid-pan {
		from { background-position: 0 0, 0 0; }
		to { background-position: 0 44px, 44px 0; }
	}

	.cyber-scanlines {
		background: repeating-linear-gradient(
			180deg,
			rgba(0, 0, 0, 0) 0px,
			rgba(0, 0, 0, 0) 2px,
			rgba(0, 0, 0, 0.18) 3px,
			rgba(0, 0, 0, 0) 4px
		);
		mix-blend-mode: multiply;
		opacity: 0.5;
	}

	.cyber-vignette {
		box-shadow: inset 0 0 220px 60px rgba(0, 0, 0, 0.85);
	}

	.cyber-fade {
		height: 8rem;
		background: linear-gradient(180deg, transparent, var(--page-bg));
	}

	/* Status tag */
	.cyber-tag {
		font-family: var(--font-mono, "JetBrains Mono Variable", monospace);
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		color: oklch(0.85 0.13 var(--hue));
		border: 1px solid oklch(0.70 0.16 var(--hue) / 0.5);
		background: oklch(0.30 0.10 var(--hue) / 0.25);
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		text-shadow: 0 0 8px oklch(0.70 0.18 var(--hue) / 0.8);
		box-shadow: 0 0 24px oklch(0.55 0.18 var(--hue) / 0.35);
	}
	.cyber-blink { animation: cyber-blink 1.1s steps(1) infinite; }
	@keyframes cyber-blink { 50% { opacity: 0; } }

	/* Glitch title */
	.cyber-glitch {
		position: relative;
		text-shadow: 0 0 22px oklch(0.65 0.20 var(--hue) / 0.55);
	}
	.cyber-glitch::before,
	.cyber-glitch::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		clip-path: inset(0 0 0 0);
	}
	.cyber-glitch::before {
		left: 2px;
		text-shadow: -2px 0 oklch(0.70 0.22 var(--hue));
		animation: cyber-glitch-1 2.6s infinite linear alternate-reverse;
	}
	.cyber-glitch::after {
		left: -2px;
		text-shadow: -2px 0 oklch(0.80 0.16 calc(var(--hue) + 180));
		animation: cyber-glitch-2 3.4s infinite linear alternate-reverse;
	}
	@keyframes cyber-glitch-1 {
		0%   { clip-path: inset(0 0 85% 0); }
		20%  { clip-path: inset(40% 0 40% 0); }
		40%  { clip-path: inset(75% 0 5% 0); }
		60%  { clip-path: inset(10% 0 70% 0); }
		80%  { clip-path: inset(55% 0 25% 0); }
		100% { clip-path: inset(30% 0 50% 0); }
	}
	@keyframes cyber-glitch-2 {
		0%   { clip-path: inset(70% 0 10% 0); }
		25%  { clip-path: inset(15% 0 65% 0); }
		50%  { clip-path: inset(50% 0 30% 0); }
		75%  { clip-path: inset(5% 0 80% 0); }
		100% { clip-path: inset(60% 0 20% 0); }
	}

	/* Terminal line */
	.cyber-terminal {
		font-family: var(--font-mono, "JetBrains Mono Variable", monospace);
		font-size: 0.85rem;
		color: oklch(0.92 0.02 var(--hue));
		background: rgba(0, 0, 0, 0.45);
		border: 1px solid oklch(0.70 0.16 var(--hue) / 0.35);
		border-radius: 0.5rem;
		padding: 0.5rem 0.9rem;
		min-width: min(90vw, 30rem);
		backdrop-filter: blur(2px);
	}
	.cyber-prompt { color: oklch(0.80 0.18 var(--hue)); }
	.cyber-path { color: oklch(0.78 0.10 calc(var(--hue) + 150)); }
	.cyber-typed { color: #e6e6e6; margin-left: 0.35rem; }
	.cyber-cursor {
		color: oklch(0.80 0.18 var(--hue));
		animation: cyber-blink 1s steps(1) infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.cyber-grid,
		.cyber-glitch::before,
		.cyber-glitch::after,
		.cyber-blink,
		.cyber-cursor { animation: none; }
	}
</style>

<script>
	function initMatrix() {
		const canvas = document.getElementById("cyber-matrix") as HTMLCanvasElement | null;
		if (!canvas) return;
		// Avoid stacking multiple animation loops across Swup navigations
		if (canvas.dataset.init === "1") return;
		canvas.dataset.init = "1";

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		const glyphs = "01ABCDEF<>/{}[]$#%&*アカサタナハマabcdef0xДЖ".split("");
		const fontSize = 16;
		let columns = 0;
		let drops: number[] = [];

		function resize() {
			const parent = canvas.parentElement;
			canvas.width = parent ? parent.clientWidth : window.innerWidth;
			canvas.height = parent ? parent.clientHeight : Math.floor(window.innerHeight * 0.65);
			columns = Math.ceil(canvas.width / fontSize);
			drops = new Array(columns).fill(0).map(() => Math.random() * -50);
		}
		resize();
		window.addEventListener("resize", resize);

		let last = 0;
		function draw(now: number) {
			// Throttle to ~24fps for a deliberate, readable rain
			if (now - last > 42) {
				last = now;
				const hue = getComputedStyle(document.documentElement).getPropertyValue("--hue").trim() || "18";

				ctx.fillStyle = "rgba(8, 8, 10, 0.16)";
				ctx.fillRect(0, 0, canvas.width, canvas.height);
				ctx.font = `${fontSize}px "JetBrains Mono Variable", monospace`;

				for (let i = 0; i < drops.length; i++) {
					const text = glyphs[Math.floor(Math.random() * glyphs.length)];
					const x = i * fontSize;
					const y = drops[i] * fontSize;

					// Bright leading glyph
					ctx.fillStyle = `oklch(0.92 0.05 ${hue})`;
					if (Math.random() > 0.975) ctx.fillStyle = "#ffffff";
					ctx.fillText(text, x, y);
					// Trailing red
					ctx.fillStyle = `oklch(0.62 0.20 ${hue} / 0.85)`;
					ctx.fillText(glyphs[Math.floor(Math.random() * glyphs.length)], x, y - fontSize);

					if (y > canvas.height && Math.random() > 0.975) drops[i] = 0;
					drops[i]++;
				}
			}
			requestAnimationFrame(draw);
		}
		requestAnimationFrame(draw);
	}

	function initTyping() {
		const el = document.getElementById("cyber-type");
		if (!el || el.dataset.init === "1") return;
		el.dataset.init = "1";

		const lines = [
			"whoami  →  red_team_engineer",
			"analyze --target blood_spatter.pcap",
			"slide.label('subject_07') && archive()",
			"cat /root/flag.txt",
		];
		let li = 0;
		let ci = 0;
		let deleting = false;

		function tick() {
			const current = lines[li];
			if (!deleting) {
				el!.textContent = current.slice(0, ++ci);
				if (ci === current.length) {
					deleting = true;
					setTimeout(tick, 1600);
					return;
				}
			} else {
				el!.textContent = current.slice(0, --ci);
				if (ci === 0) {
					deleting = false;
					li = (li + 1) % lines.length;
				}
			}
			setTimeout(tick, deleting ? 28 : 55);
		}
		tick();
	}

	function boot() {
		initMatrix();
		initTyping();
	}

	boot();
	// Re-init after Swup page transitions if the banner is re-rendered
	document.addEventListener("swup:enable", () =>
		window.swup?.hooks?.on?.("page:view", boot),
	);
</script>
