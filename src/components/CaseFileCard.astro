---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style?: string;
	index: number;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
	index,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";
const { remarkPluginFrontmatter } = await entry.render();

const dateStr = published.toISOString().slice(0, 10).replace(/-/g, ".");
const caseNo = String(index + 1).padStart(3, "0");
const year = published.getFullYear();
const pins = ["red", "amber", "steel"];
const pin = pins[index % pins.length];
const rot = ((index * 37) % 5) - 2; // deterministic tilt between -2 and +2 deg
---
<div class:list={["case-file", className]} style={`--rot:${rot}deg; ${style || ""}`}>
    <span class={`case-file__pin pin-${pin}`}></span>
    <span class="case-file__tape"></span>

    <article class="case-file__paper">
        <!-- click-anywhere link -->
        <a href={url} class="case-file__open" aria-label={`Open case file: ${title}`}></a>

        <!-- header -->
        <header class="case-file__head">
            <span class="case-file__no">CASE&nbsp;#{year}-{caseNo}</span>
            <span class="case-file__stamp">CLASSIFIED</span>
        </header>

        <!-- evidence photo / redacted placeholder -->
        {hasCover ? (
            <div class="case-file__photo">
                <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))}
                    alt="Evidence photo" class="w-full h-full object-cover" />
                <span class="case-file__photo-tag">EXHIBIT A</span>
            </div>
        ) : (
            <div class="case-file__photo case-file__photo--none">
                <span>// NO PHOTO ON FILE //</span>
            </div>
        )}

        <!-- subject / title -->
        <div class="case-file__label">SUBJECT</div>
        <h3 class="case-file__title">{title}</h3>

        <!-- meta line -->
        <div class="case-file__meta">
            <span>🗓 {dateStr}</span>
            {category && <span class="case-file__cat">{category}</span>}
        </div>

        <!-- brief -->
        <p class="case-file__brief">{description || remarkPluginFrontmatter.excerpt}</p>

        <!-- tags as evidence labels -->
        {tags && tags.length > 0 && (
            <div class="case-file__tags">
                {tags.slice(0, 4).map((t) => <span class="case-file__chip">{t.trim()}</span>)}
            </div>
        )}

        <!-- footer -->
        <footer class="case-file__foot">
            <span>{remarkPluginFrontmatter.minutes} min · {remarkPluginFrontmatter.words} words</span>
            <span class="case-file__open-label">OPEN FILE →</span>
        </footer>
    </article>
</div>
