---
import { Icon } from "astro-icon/components";
import { profileConfig, navBarConfig, siteConfig } from "../../config";
import { LinkPresets } from "../../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div class="p-5 flex flex-col items-center" style="background-color: var(--sidebar-bg, #1e1e1e);">
    <!-- Circular Avatar with Chirpy-style border -->
    <a aria-label="Go to Home" href={url('/')}
       class="group block w-[6.5rem] h-[6.5rem] rounded-full overflow-hidden
              hover:scale-[1.05] transition-all mb-4 active:scale-95"
       style="border: 2px solid rgba(206,206,206,0.9);">
        <ImageWrapper src={config.avatar || ""} alt="Profile Image" class="w-full h-full object-cover"></ImageWrapper>
    </a>

    <!-- Site Title - Chirpy style -->
    <a href={url('/')} class="font-bold text-xl transition mb-0.5 hover:opacity-80"
       style="font-family: 'Lato', sans-serif; color: #717070;">
        {siteConfig.title}
    </a>

    <!-- Tagline - Chirpy subtitle color -->
    <div class="text-sm mb-5" style="color: #868686;">{config.bio}</div>

    <!-- Navigation Links - Chirpy horizontal style -->
    <nav class="flex flex-wrap gap-x-4 gap-y-2 justify-center mb-5">
        {links.map((l) => (
            <a href={l.external ? l.url : url(l.url)}
               target={l.external ? "_blank" : null}
               class="text-xs font-semibold uppercase tracking-wider transition hover:opacity-100"
               style="color: #868686;">
                {l.name}
            </a>
        ))}
    </nav>

    <!-- Divider -->
    <div class="w-full h-px mb-4" style="background-color: #292929;"></div>

    <!-- Social Icons - Chirpy button style -->
    <div class="flex gap-3">
        {config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank"
               class="w-9 h-9 rounded-full flex items-center justify-center transition"
               style="background-color: #232328; color: #787878;">
                <Icon name={item.icon} class="text-[1.1rem]"></Icon>
            </a>
        )}
    </div>
</div>
