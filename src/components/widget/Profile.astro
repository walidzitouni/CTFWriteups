---
import { Icon } from "astro-icon/components";
import { profileConfig, navBarConfig, siteConfig } from "../../config";
import { LinkPresets } from "../../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div class="card-base p-5 flex flex-col items-center">
    <!-- Circular Avatar -->
    <a aria-label="Go to Home" href={url('/')}
       class="group block w-28 h-28 rounded-full overflow-hidden border-2 border-white/10
              hover:border-[var(--primary)] transition-all mb-4 active:scale-95">
        <ImageWrapper src={config.avatar || ""} alt="Profile Image" class="w-full h-full object-cover"></ImageWrapper>
    </a>

    <!-- Blog Name -->
    <a href={url('/')} class="font-bold text-xl text-white/90 hover:text-[var(--primary)] transition mb-1">
        {siteConfig.title}
    </a>

    <!-- Tagline -->
    <div class="text-sm text-white/40 mb-5">{config.bio}</div>

    <!-- Navigation Links - horizontal flow -->
    <nav class="flex flex-wrap gap-x-4 gap-y-2 justify-center mb-5">
        {links.map((l) => (
            <a href={l.external ? l.url : url(l.url)}
               target={l.external ? "_blank" : null}
               class="text-xs font-semibold uppercase tracking-wider text-white/50 hover:text-[var(--primary)] transition">
                {l.name}
            </a>
        ))}
    </nav>

    <!-- Divider -->
    <div class="w-full h-px bg-white/8 mb-4"></div>

    <!-- Social Icons -->
    <div class="flex gap-3">
        {config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank"
               class="w-9 h-9 rounded-lg flex items-center justify-center
                      text-white/40 hover:text-[var(--primary)] hover:bg-white/5 transition">
                <Icon name={item.icon} class="text-[1.25rem]"></Icon>
            </a>
        )}
    </div>
</div>
