/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
/* For forced dark theme: both light and dark values are the dark variant */
define(vars)
  :root
    for key, value in vars
      if length(value) > 1
        {key}: value[1]
      else
        {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.72 0.14 160) oklch(0.72 0.14 160)
  --page-bg: #0e1117 #0e1117
  --card-bg: #161b22 #161b22

  --btn-content: oklch(0.75 0.1 160) oklch(0.75 0.1 160)

  --btn-regular-bg: rgba(255,255,255,0.06) rgba(255,255,255,0.06)
  --btn-regular-bg-hover: rgba(255,255,255,0.10) rgba(255,255,255,0.10)
  --btn-regular-bg-active: rgba(255,255,255,0.14) rgba(255,255,255,0.14)

  --btn-plain-bg-hover: rgba(255,255,255,0.06) rgba(255,255,255,0.06)
  --btn-plain-bg-active: rgba(255,255,255,0.04) rgba(255,255,255,0.04)

  --btn-card-bg-hover: rgba(255,255,255,0.05) rgba(255,255,255,0.05)
  --btn-card-bg-active: rgba(255,255,255,0.08) rgba(255,255,255,0.08)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: white(0.9)

  --title-active: oklch(0.65 0.12 160)

  --line-divider: white(0.08) white(0.08)

  --line-color: white(0.1) white(0.1)
  --meta-divider: white(0.2) white(0.2)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.40 0.08 160) oklch(0.40 0.08 160)
  --codeblock-selection: oklch(0.40 0.08 160)
  --codeblock-bg: #0d1117 #0d1117
  --codeblock-topbar-bg: #161b22 #161b22

  --license-block-bg: var(--codeblock-bg) var(--codeblock-bg)

  --link-underline: oklch(0.40 0.08 160) oklch(0.40 0.08 160)
  --link-hover: oklch(0.50 0.10 160) oklch(0.50 0.10 160)
  --link-active: oklch(0.35 0.07 160) oklch(0.35 0.07 160)

  --float-panel-bg: #1c2128 #1c2128

  --scrollbar-bg-light: white(0.4)
  --scrollbar-bg-hover-light: white(0.5)
  --scrollbar-bg-active-light: white(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-dark) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-dark rainbow-dark

  --display-light-icon: 0 0
  --display-dark-icon: 1 1

  --admonitions-color-tip: oklch(0.75 0.14 160) oklch(0.75 0.14 160)
  --admonitions-color-note: oklch(0.75 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: var(--btn-regular-bg) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.22 0.02 160) oklch(0.22 0.02 160)
  --toc-btn-active: oklch(0.25 0.02 160) oklch(0.25 0.02 160)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.35 0.07 160) oklch(0.35 0.07 160)
})
