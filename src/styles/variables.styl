/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 0.625rem
  --content-delay 150ms

/* Forced dark theme matching Chirpy's exact color palette */
define(vars)
  :root
    for key, value in vars
      if length(value) > 1
        {key}: value[1]
      else
        {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  /* Chirpy exact colors */
  --primary: #8ab4f8 #8ab4f8
  --page-bg: #1b1b1e #1b1b1e
  --card-bg: #1e1e1e #1e1e1e

  --btn-content: #a7a7a7 #a7a7a7

  --btn-regular-bg: #232328 #232328
  --btn-regular-bg-hover: #2e2e2e #2e2e2e
  --btn-regular-bg-active: #353535 #353535

  --btn-plain-bg-hover: #262626 #262626
  --btn-plain-bg-active: #2e2e2e #2e2e2e

  --btn-card-bg-hover: #464d51 #464d51
  --btn-card-bg-active: #353535 #353535

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #cccccc

  --title-active: #8ab4f8

  --line-divider: rgb(44 45 45) rgb(44 45 45)

  --line-color: rgb(44 45 45) rgb(44 45 45)
  --meta-divider: #868686 #868686

  --inline-code-bg: rgba(255,255,255,0.05) rgba(255,255,255,0.05)
  --inline-code-color: #c9def1 #c9def1
  --selection-bg: rgba(138,180,248,0.3) rgba(138,180,248,0.3)
  --codeblock-selection: rgba(138,180,248,0.3)
  --codeblock-bg: #151515 #151515
  --codeblock-topbar-bg: #292929 #292929

  --license-block-bg: #151515 #151515

  --link-underline: rgb(82 108 150) rgb(82 108 150)
  --link-hover: #8ab4f8 #8ab4f8
  --link-active: rgb(82 108 150) rgb(82 108 150)

  --float-panel-bg: #1e1e1e #1e1e1e

  --scrollbar-bg-light: white(0.4)
  --scrollbar-bg-hover-light: white(0.5)
  --scrollbar-bg-active-light: white(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-dark) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-dark rainbow-dark

  --display-light-icon: 0 0
  --display-dark-icon: 1 1

  --admonitions-color-tip: rgb(15 164 15 / 81%) rgb(15 164 15 / 81%)
  --admonitions-color-note: #0075d1 #0075d1
  --admonitions-color-important: #8ab4f8 #8ab4f8
  --admonitions-color-warning: rgb(255 165 0 / 80%) rgb(255 165 0 / 80%)
  --admonitions-color-caution: #cd0202 #cd0202

  --toc-badge-bg: #232328 #232328
  --toc-btn-hover: #262626 #262626
  --toc-btn-active: #2e2e2e #2e2e2e
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: rgb(116 178 243) rgb(116 178 243)

  /* Chirpy-specific extras */
  --sidebar-bg: #1e1e1e
  --sidebar-muted: #868686
  --sidebar-active: rgba(255,255,255,0.95)
  --sidebar-hover-bg: #262626
  --text-color: rgb(175 176 177)
  --heading-color: #cccccc
  --tag-hover: rgb(43 56 62)
  --tag-border: rgb(59 79 88)
  --tb-odd-bg: #252526
  --tb-even-bg: rgb(31 31 34)
  --card-shadow: 0 6px 18px 0 rgba(21,21,21,0.72)
})
